# Railway: en el panel del servicio MySQL copia las variables tal cual.
# Puedes usar nombres DB_* o los que expone Railway (MYSQL*).
#
# DB_HOST=zephyr.proxy.rlwy.net
# DB_PORT=55846
# DB_NAME=railway
# DB_USER=root
# DB_PASSWORD=tu_password
#
# O directamente (Railway las inyecta automáticamente al enlazar servicios):
# MYSQLHOST=...
# MYSQLPORT=...
# MYSQLDATABASE=...
# MYSQLUSER=...
# MYSQLPASSWORD=...
